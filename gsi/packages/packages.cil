; EXPERIMENTAL: private package environment, not an Android root installer.
(type nativos_package)
(type nativos_package_exec)
(type nativos_package_file)
(typeattributeset domain (nativos_package))
(typeattributeset coredomain (nativos_package))
(typeattributeset netdomain (nativos_package))
(typeattributeset nativos_linux_client (nativos_package))
(typeattributeset file_type (nativos_package_exec nativos_package_file))
(typeattributeset exec_type (nativos_package_exec))
(typeattributeset system_file_type (nativos_package_exec))
(typeattributeset data_file_type (nativos_package_file))
(typeattributeset core_data_file_type (nativos_package_file))
(roletype r nativos_package)
; Native Linux app domain, NOT Android appdomain: vendor public appdomain rules
; would add ART execmem and unrelated Android permissions. The platform has a
; checked private-data execution exception for this exact domain/file pair.
; No mlstrustedsubject exemption, capability, mount or execmem permission.
(typetransition nativos_session nativos_package_exec process nativos_package)
(allow nativos_session nativos_package_exec (file (read open getattr execute map)))
(allow nativos_session nativos_package (process (transition siginh rlimitinh signal sigkill sigstop signull)))
(allow nativos_session nativos_package (process2 (nnp_transition nosuid_transition)))
(allow nativos_package nativos_package_exec (file (read open getattr execute map entrypoint execute_no_trans)))
(allow nativos_package nativos_session (process (sigchld)))
(allow nativos_package nativos_session (fd (use)))
(allow nativos_package nativos_session (fifo_file (read write getattr ioctl)))
(allowx nativos_package nativos_session (ioctl fifo_file (0x5401)))
(allow nativos_session nativos_package (fd (use)))
; PRoot may trace ONLY children in its own domain, never the desktop/browser/Android.
(allow nativos_package self (process (fork ptrace sigchld signal sigkill sigstop signull getpgid setpgid getsession setrlimit)))
(allow nativos_package nativos_session (unix_stream_socket (connectto)))
(typetransition nativosd nativos_runtime_file dir "packages" nativos_package_file)
(allow nativosd nativos_package_file (dir (create search read write open getattr setattr add_name remove_name)))
(allow nativos_session nativos_package_file (dir (search read write open getattr setattr add_name remove_name create rename rmdir mounton)))
(allow nativos_session nativos_package_file (file (create read write append link open getattr setattr unlink rename lock)))
(allow nativos_session nativos_package_file (lnk_file (create read getattr setattr link unlink rename)))
(allow nativos_package nativos_package_file (dir (search read write open getattr setattr add_name remove_name create rename rmdir reparent watch)))
(allow nativos_package nativos_package_file (file (create read write append link open getattr setattr unlink rename lock map watch watch_reads execute execute_no_trans ioctl)))
(allowx nativos_package nativos_package_file (ioctl file (0x5401 0x5451)))
(allow nativos_package nativos_package_file (lnk_file (create read getattr setattr link unlink rename)))
(allow nativos_package nativos_package_file (fifo_file (create read write open getattr setattr unlink ioctl)))
(allowx nativos_package nativos_package_file (ioctl fifo_file (0x5401)))
(allow nativos_package nativos_package_file (sock_file (create read write open getattr setattr unlink)))
